      "unit_code": "6N3",
      "title_zh": "百分數(一)",
      "ks": "KS2",
      "year_hint": "P6",
      "drill_families": ["percent_conversion_optional"],
      "constraints": "百分數概念；百分數↔小數；百分數↔分數。選配延展，非本輪P0主線。",
      "priority": "P2",
      "in_scope": true
    },
    {
      "unit_code": "6N4",
      "title_zh": "百分數(二)",
      "ks": "KS2",
      "year_hint": "P6",
      "drill_families": ["percent_conversion_optional"],
      "constraints": "簡易百分數與百分變化應用題為主；求原本的數在6A1。應用題非本階段主產品。",
      "priority": "P2",
      "in_scope": true
    }
